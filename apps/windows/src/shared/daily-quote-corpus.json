{
  "source": {
    "repository": "acdzh/SayingDatabase-Chinese",
    "commit": "a8e04731b33e056c78e9de2303208b5d80143a01",
    "blob": "3fbc0dd36e7bfded5ac694e7bbf09280e8e2d4eb",
    "license": "WTFPL-2.0"
  },
  "quotes": [
    {
      "id": "saying-04461c46ad33debd",
      "text": "使一个人的有限的生命，更加有效，也即等于延长了人的生命。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-04d2cfea0a67e890",
      "text": "不爱尺壁而重爱寸阴，时难遭而易失也。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-04ebf051e33e8c50",
      "text": "好的先生不是教书，不是教学生，乃是教学生学。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-05045752c199f07d",
      "text": "不以规矩，无以成方圆。",
      "attribution": "孟子"
    },
    {
      "id": "saying-05eb861b318fa54f",
      "text": "非宁静无以成学。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-07ab7938175f2df4",
      "text": "燕雀安知鸿鹄之志。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-09e6d7eea92f1966",
      "text": "人类是一种使思想开花结果的植物。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-0a4017edb4a188fe",
      "text": "君子在下位则多谤，在上位则多誉；小人在下位则多誉，在上位则多谤。",
      "attribution": "柳宗元"
    },
    {
      "id": "saying-0a87337ff649b753",
      "text": "读书无疑者，须教有疑，有疑者，却要无疑，到这里方是长进。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-0b6534da0d9012bb",
      "text": "规小节者不能成荣名，恶小耻者不能立大功。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-0bec85b546dc810b",
      "text": "圣人终不为大，故能成其大。",
      "attribution": "老子"
    },
    {
      "id": "saying-0c723a9714dfb049",
      "text": "人必须生活着，爱才有所附丽。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-0ce1175b3eb8d541",
      "text": "仁者如射，射者正已而后发。",
      "attribution": "孟子"
    },
    {
      "id": "saying-0cf6ba765ef6ac4f",
      "text": "不能感人，皆诚之不至。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-0ff2c831e48c0588",
      "text": "若无德，则虽体魄智力发达，适足助其为恶。",
      "attribution": "蔡元培"
    },
    {
      "id": "saying-104f1dd5cab7cf47",
      "text": "仁者无敌于天下。",
      "attribution": "孟子"
    },
    {
      "id": "saying-10ffd4eeb576f13d",
      "text": "哪里有天才，我是把别人喝咖啡的工夫都用在学习上的。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-111a2a0056812c3f",
      "text": "读书患不多，思义患不明；足己患不学，既学患不行。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-120aebfaa2c4cc57",
      "text": "一定要有自信的勇气，才会有工作的勇气。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-1305161729fd036b",
      "text": "人非生而知之者，孰能无惑。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-13e12b7ca46919df",
      "text": "生命是以时间为单位的，浪费别人的时间等于谋财害命；浪费自己的时间，等于慢性自杀。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-13eac3762de4f8dd",
      "text": "君子莫大乎与人为善。",
      "attribution": "孟子"
    },
    {
      "id": "saying-14212d9db8e2c3e4",
      "text": "人生得一知己足矣，斯世当以同怀视之。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-15053030c4d2df66",
      "text": "人之进学在于思，思则能知是与非。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-17a1dcf862f44484",
      "text": "轻诺必寡信，多易必多难。",
      "attribution": "老子"
    },
    {
      "id": "saying-19430493d933b75d",
      "text": "论天下者，必循天下之公。",
      "attribution": "王夫之"
    },
    {
      "id": "saying-1a3026cb5f25eff8",
      "text": "自修则人不得以非理相加。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-1eda53b5b94a7f7d",
      "text": "知足不辱，知止不殆。",
      "attribution": "老子"
    },
    {
      "id": "saying-2470a97f4019f892",
      "text": "天下兴亡，匹夫有责。",
      "attribution": "顾炎武"
    },
    {
      "id": "saying-24d06709704e778c",
      "text": "时间，就象海绵里的水，只要愿挤，总还是有的。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-24ef05a655832075",
      "text": "老吾老以及人之老；幼吾幼以及人之幼。",
      "attribution": "孟子"
    },
    {
      "id": "saying-251771ae9e23bcd4",
      "text": "得道多助，失道寡助。",
      "attribution": "孟子"
    },
    {
      "id": "saying-26404a97260726ba",
      "text": "仁者谓其中心欣然爱人也。",
      "attribution": "韩非子"
    },
    {
      "id": "saying-268fc10e5833d8f9",
      "text": "当务之急，不求难知；力行所知，不惮所难为。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-27e328edcb6c87a8",
      "text": "吾生也有涯，而知也无涯。",
      "attribution": "庄子"
    },
    {
      "id": "saying-2b016db1fa104c41",
      "text": "自古皆有死，民无信不立。",
      "attribution": "孔子"
    },
    {
      "id": "saying-2dac48cbe92e6ff6",
      "text": "时势为天子，未必贵也；穷为匹夫，未必贱也。贵贱之分，在于行之美恶。",
      "attribution": "庄子"
    },
    {
      "id": "saying-2df01c826fe03f71",
      "text": "业精于勤，荒于嬉；行成于思，毁于惰。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-31d20b7c0983100e",
      "text": "海纳百川，有容乃大；壁立千仞，无欲则刚。",
      "attribution": "林则徐"
    },
    {
      "id": "saying-34f406860140881e",
      "text": "不登高山，不知天之高也；不临深渊，不知地之厚也。",
      "attribution": "荀子"
    },
    {
      "id": "saying-35b57f2a08e17729",
      "text": "自是者不章，自建者不立。",
      "attribution": "荀子"
    },
    {
      "id": "saying-35fb0ed43adfc23f",
      "text": "千教万教教人求真，千学万学学做真人。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-3f9bf25b675d6921",
      "text": "不塞不流，不止不行。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-3fafb6ad80c1f3be",
      "text": "俱收并蓄，待用无遗。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-427203591ae24665",
      "text": "什么是路？就是从没有路的地方践踏出来的，从只有荆棘的地方开辟出来的。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-4b9df375a76f3b64",
      "text": "天时不如地利，地利不如人和。",
      "attribution": "孟子"
    },
    {
      "id": "saying-4c3f6f3e0c3c1249",
      "text": "生活太安逸了，工作就被生活所累。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-4d704f5422365b7f",
      "text": "心大则百物皆通，心小则百物皆病。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-5022f7678640284a",
      "text": "夫君子之行，静以修身，俭以养德，非淡泊无以明志，非宁静无以致远。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-5162a0f9edb3818c",
      "text": "立志不坚，终不济事。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-51f1a56cf08ecc8c",
      "text": "富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。",
      "attribution": "孟子"
    },
    {
      "id": "saying-524b24368b77e8a9",
      "text": "三人行必有我师焉；择其善者而从之，其不善者而改之。",
      "attribution": "孔子"
    },
    {
      "id": "saying-54d3660bc0098a1e",
      "text": "光是话不行，要紧的是做。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-56435f96619d5918",
      "text": "以过去和现在的铁铸一般的事实来测将来，洞若观火！",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-5690170dc07a745b",
      "text": "枉己者，未有能直人者也。",
      "attribution": "孟子"
    },
    {
      "id": "saying-57be23df1d013fea",
      "text": "捧着一颗心来，不带半根草去。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-5ac1e7fe050b9183",
      "text": "君子小人趣向不同，公私之间而已。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-5bc035708ee8b0e6",
      "text": "自敬，则人敬之；自慢，则人慢之。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-5dfaf4e3978e3dd9",
      "text": "轻千乘之国，而重一言之信。",
      "attribution": "墨子"
    },
    {
      "id": "saying-5f5cf1501ac7f90c",
      "text": "日省其身，有则改之，无则加勉。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-5f7a00f094554856",
      "text": "涵养、致知、力行三者，便是以涵养为首，致知次之，力行又次之。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-69169e5b56a75ac5",
      "text": "以权利合者，权尽而交疏。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-6bef5218148a3af5",
      "text": "守正直而佩仁义。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-6e3f261e301a906e",
      "text": "势利之交，难以经远。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-72e4a98b76a8c10e",
      "text": "不胜其任，而处其位，非此位之人也。",
      "attribution": "墨子"
    },
    {
      "id": "saying-7c0b5f9669f52ce8",
      "text": "人光明磊落便是好人。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-7c790d9502afc0c6",
      "text": "与朋友交，严而有信。",
      "attribution": "孔子"
    },
    {
      "id": "saying-7cde7d7e2fd313ee",
      "text": "夫学须志也，才须学也，非学无以广才，非志无以成学。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-7e40718e7f6aa314",
      "text": "读书之法，在循序而渐进，熟读而精思。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-7e9e00e73c433d0f",
      "text": "芝兰生于幽林，不以无人而不芳；君子修道立德，不为穷困而改节。",
      "attribution": "孔子"
    },
    {
      "id": "saying-806f87f2165abb34",
      "text": "嘉赏未尝喜，抑挫未尝惧。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-853f5f90fd3f767c",
      "text": "不为福先，不为祸始。感而后应，迫而后动，不得已而后起。",
      "attribution": "庄子"
    },
    {
      "id": "saying-8675f2ef534a4d90",
      "text": "达则兼济天下，穷则独善其身。",
      "attribution": "孟子"
    },
    {
      "id": "saying-87c4840aff3a3a40",
      "text": "天下难事，必作于易；天下大事，必作于细。",
      "attribution": "老子"
    },
    {
      "id": "saying-8e9466c008e0c326",
      "text": "修身者智之府也，爱施者仁之端也，取予者义之符也，耻辱者勇之决也。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-93f941344b911d27",
      "text": "人生处万类，知识最为贤。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-99cc8f7c8aad4a37",
      "text": "形相虽恶，而心术善，无害为君子也。",
      "attribution": "荀子"
    },
    {
      "id": "saying-9b6a804bc2ed30ca",
      "text": "为学当有实功，有实用。",
      "attribution": "梁启超"
    },
    {
      "id": "saying-9d28ff7feb53109f",
      "text": "泰山不让土壤，故能成其大；河海不择细流，故能就其深。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-9e93e58d12fa0664",
      "text": "以近知远，一以知万，以微知明。",
      "attribution": "荀子"
    },
    {
      "id": "saying-9f11d70c52dcb59a",
      "text": "人之为学，不可自小，又不可自大。",
      "attribution": "顾炎武"
    },
    {
      "id": "saying-a0328bb4ec2bacca",
      "text": "科学的根本精神，全在养成观察力。",
      "attribution": "梁启超"
    },
    {
      "id": "saying-a0a4af9a20ddc9e7",
      "text": "君子谋道不谋食，忧道不忧贫。",
      "attribution": "孔子"
    },
    {
      "id": "saying-a1c7966c1799ea1e",
      "text": "明者远见于未萌而智者避危于无形。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-a3cc8f83b8681a34",
      "text": "人生百年，立于幼学。",
      "attribution": "梁启超"
    },
    {
      "id": "saying-a99a868707ddd916",
      "text": "人的健全，不但靠饮食，尤靠运动。",
      "attribution": "蔡元培"
    },
    {
      "id": "saying-acc5b4af23eac727",
      "text": "学者志不立，一经患难，愈见消沮。",
      "attribution": "黄宗羲"
    },
    {
      "id": "saying-ae721ab9d6558d5f",
      "text": "学易而好难，行易而力难，耻易而知难。",
      "attribution": "王夫之"
    },
    {
      "id": "saying-aef4be4b5d36025a",
      "text": "其身正，不令而行；其身不正，虽令不行。",
      "attribution": "孔子"
    },
    {
      "id": "saying-af16316eae3a060c",
      "text": "为学，正如撑上水船，一篙不可放缓。",
      "attribution": "朱熹"
    },
    {
      "id": "saying-b3e2de23e06ddef7",
      "text": "天下大事当于大处著眼，小处下手。",
      "attribution": "老子"
    },
    {
      "id": "saying-b802d4f3901a40ab",
      "text": "君子之交淡如水，小人之交甘若醴。",
      "attribution": "庄子"
    },
    {
      "id": "saying-b9fad2224f2822ec",
      "text": "学知不足，业精于勤。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-ba5cc1fe8ef8f94b",
      "text": "以五十步笑百步。",
      "attribution": "孟子"
    },
    {
      "id": "saying-bce45abc0932c724",
      "text": "君子崇人之德，扬人之美，非谄谀也。",
      "attribution": "荀子"
    },
    {
      "id": "saying-be98adf468da775f",
      "text": "其交也以道，以接也以礼。",
      "attribution": "孟子"
    },
    {
      "id": "saying-bedb467e40218f24",
      "text": "生于忧患，死于安乐。",
      "attribution": "孟子"
    },
    {
      "id": "saying-beeb4c71270ec2ae",
      "text": "人皆可以为尧舜。",
      "attribution": "孟子"
    },
    {
      "id": "saying-bf9c365efecd3ffd",
      "text": "智不自智，而后人莫与争智。",
      "attribution": "老子"
    },
    {
      "id": "saying-c35268c1ffdfa28c",
      "text": "士之相知，温不增华，寒不改叶，能四时而不衰，历夷险而益固。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-c7de579ac8834f87",
      "text": "恢弘志士之气，不宜妄自菲薄。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-cc5f0e5f435dae3b",
      "text": "飘风不终朝，骤雨不终日。",
      "attribution": "老子"
    },
    {
      "id": "saying-d14b78fcd3dcb3a3",
      "text": "言不信者，行不果。",
      "attribution": "墨子"
    },
    {
      "id": "saying-d4ddb61ad3657b8a",
      "text": "人生天地之间，若白驹过隙，忽然而已。",
      "attribution": "庄子"
    },
    {
      "id": "saying-d5dd25363d5c0859",
      "text": "有发明之力者虽旧必新，无发明之力者虽新必旧。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-d61282948ef7c6e7",
      "text": "博爱之谓仁，行而宜之谓义。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-d8436611cf8cc888",
      "text": "大直若屈，大巧若拙，大辨若讷。",
      "attribution": "老子"
    },
    {
      "id": "saying-d8ca4a4017a1d9df",
      "text": "好便宜者，不可与之交财，多狐疑者，不可与之谋事。",
      "attribution": "左宗棠"
    },
    {
      "id": "saying-d9bed28d46e1d8d2",
      "text": "公生明，偏生暗。",
      "attribution": "荀子"
    },
    {
      "id": "saying-da92be90c741f6a4",
      "text": "立志难也，不在胜人，在自胜。",
      "attribution": "韩非子"
    },
    {
      "id": "saying-deca28ed29e44103",
      "text": "是谓是，非谓非，曰直。",
      "attribution": "荀子"
    },
    {
      "id": "saying-e4459d37fbd13dca",
      "text": "君子耻不修，不耻见污。",
      "attribution": "荀子"
    },
    {
      "id": "saying-e57e2d0fc70c862a",
      "text": "世有伯乐，然后有千里马。千里马常有而伯乐不常有。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-ea4fed7ab4694fce",
      "text": "君子养心，莫善于诚。",
      "attribution": "荀子"
    },
    {
      "id": "saying-eaa47313802a0a03",
      "text": "忽略健康的人，就是等于在与自己的生命开玩笑。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-ec42290245b6b599",
      "text": "力行而后知之真。",
      "attribution": "王夫之"
    },
    {
      "id": "saying-ecbc3f3e7f59dab9",
      "text": "闻道有先后，术业有专攻。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-eeef7960ec033f08",
      "text": "兴天下之利，除天下之害。",
      "attribution": "墨子"
    },
    {
      "id": "saying-f07c0f50f7c0b50b",
      "text": "欲思其利，必虑其害，欲思其成，必虑其败。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-f2462ad7dd41ab31",
      "text": "大事起于难，小事起于易。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-f7461be7cc3e2d3a",
      "text": "勿以身贵而贱人，勿以独见而违众，勿恃功能而失信。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-f9f32f28ab5ce1e4",
      "text": "学如才识，不日进，则日退。",
      "attribution": "左宗棠"
    },
    {
      "id": "saying-fb69a3533eec76cb",
      "text": "不傲才以骄人，不以宠而作威。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-fccf7445abed1ff8",
      "text": "无贵无贱，无长无少，道之所存，师之所存也。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-1b780d3742b3ffc5",
      "text": "怀疑并不是缺点。总是疑，而并不下断语，这才是缺点。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-2fd269f961407d19",
      "text": "无论什么事，如果不断收集材料，积之十年，总可成一学者。",
      "attribution": "鲁迅"
    },
    {
      "id": "saying-22b0b5615ef605e0",
      "text": "权，然后知轻重；度，然后知长短。",
      "attribution": "孟子"
    },
    {
      "id": "saying-5e219190df1180e1",
      "text": "养心莫善于寡欲。",
      "attribution": "孟子"
    },
    {
      "id": "saying-2053943befadfa15",
      "text": "来世不可待，往世不可追也。",
      "attribution": "庄子"
    },
    {
      "id": "saying-4d4a1dd47443cd6b",
      "text": "朴素而天下莫能与争美。",
      "attribution": "庄子"
    },
    {
      "id": "saying-a6b23617e5825cff",
      "text": "安时而处顺，哀乐不能入也。",
      "attribution": "庄子"
    },
    {
      "id": "saying-6d777a357ca3ab9d",
      "text": "志不强者智不达，言不信者行不果。",
      "attribution": "墨子"
    },
    {
      "id": "saying-40c7b08dc4846aa8",
      "text": "智者贵在乘时，时不可失。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-674872728d5f71f0",
      "text": "得人者兴，失人者崩。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-9ade3cc3ce2f2886",
      "text": "不知其人，视其友。",
      "attribution": "司马迁"
    },
    {
      "id": "saying-29239a9e3b4ba420",
      "text": "怠者不能修，而忌者畏人修。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-7c87e0b7764ee09a",
      "text": "因循二字，从来误尽英雄。",
      "attribution": "韩愈"
    },
    {
      "id": "saying-9020ff9e58080899",
      "text": "目失镜，则无以正须眉；身失道，则无以知迷惑。",
      "attribution": "韩非子"
    },
    {
      "id": "saying-76f3d75ba9ee0978",
      "text": "伯乐不可欺马，君子不可以欺人。",
      "attribution": "荀子"
    },
    {
      "id": "saying-d7a595e1ea60eb3a",
      "text": "君子博学而日参省乎己，则智明而行无过矣。",
      "attribution": "荀子"
    },
    {
      "id": "saying-9cc7ea789660a9f3",
      "text": "与其守成法，毋宁尚自然；与其求划一，毋宁展个性。",
      "attribution": "蔡元培"
    },
    {
      "id": "saying-a223a5f53699401f",
      "text": "囊括大典，网罗众家；思想自由，兼容并包。",
      "attribution": "蔡元培"
    },
    {
      "id": "saying-5d1e20b68746833f",
      "text": "处处是创造之地，天天是创造之时，人人是创造之人。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-a496029bf07c608d",
      "text": "科学的使命，是要造福社会，而不是造福个人。",
      "attribution": "陶行知"
    },
    {
      "id": "saying-7735f83af4588042",
      "text": "非精不能明其理，非博不能至于约。",
      "attribution": "梁启超"
    },
    {
      "id": "saying-3d36d81a0dfc6b46",
      "text": "自古圣贤，盛德大业，未有不由学而成者也。",
      "attribution": "黄宗羲"
    },
    {
      "id": "saying-a71995c07e52b43a",
      "text": "大丈夫行事，论是非，不论利害；论顺逆，不论成败；论万世，不论一生。",
      "attribution": "黄宗羲"
    },
    {
      "id": "saying-2b5f434b4ab5fcbd",
      "text": "私欲之中，天理所寓。",
      "attribution": "王夫之"
    },
    {
      "id": "saying-27693ae71d94d91c",
      "text": "贵而不骄，胜而不悖，贤而能下，刚而能忍。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-33450b610dae8177",
      "text": "喜不应喜无喜之事，怒不应怒无怒之物。",
      "attribution": "诸葛亮"
    },
    {
      "id": "saying-483a784d3420dc34",
      "text": "以其无私，故能成其私。",
      "attribution": "老子"
    },
    {
      "id": "saying-9a77720d69f06671",
      "text": "祸兮，福之所倚；福兮，祸之所伏。",
      "attribution": "老子"
    },
    {
      "id": "saying-a3b9ef0f72ad71d8",
      "text": "独学而无友，则孤陋而寡闻。",
      "attribution": "孔子"
    }
  ]
}
